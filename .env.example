# Backend listener published by Docker Compose.
MORDRED_BIND_ADDRESS=127.0.0.1
MORDRED_BIND_PORT=8000

# LM Studio on the private G14 connection.
# Never place a real private address or credential in this example.
MORDRED_LM_STUDIO_BASE_URL=http://g14-private-address:1234
MORDRED_LM_STUDIO_API_KEY=PLACEHOLDER
MORDRED_LM_STUDIO_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive

# Bounded upstream timeouts, in seconds.
MORDRED_CONNECT_TIMEOUT_SECONDS=3
MORDRED_READ_TIMEOUT_SECONDS=90

# Credential clients will use when calling the Mordred backend.
MORDRED_BACKEND_API_KEY=PLACEHOLDER

# Conversational generation defaults.
MORDRED_CHAT_TEMPERATURE=0.7
MORDRED_CHAT_MAX_OUTPUT_TOKENS=1024

# Temporary, non-persistent conversation-history bounds.
MORDRED_CONVERSATION_MAX_MESSAGES=12
MORDRED_CONVERSATION_MAX_CHARACTERS=24000

# Telegram adapter. Keep the real bot token and IDs only in the ignored .env.
# Use positive numeric Telegram user IDs (comma-separated for multiple users).
# Only allowlisted users in private chats can reach the backend.
MORDRED_TELEGRAM_BOT_TOKEN=PLACEHOLDER
MORDRED_TELEGRAM_ALLOWED_USER_IDS=123456789

# The adapter reaches the backend by its Compose service name.
MORDRED_TELEGRAM_BACKEND_BASE_URL=http://backend:8000

# Set this to the same real value as MORDRED_BACKEND_API_KEY in private .env.
MORDRED_TELEGRAM_BACKEND_API_KEY=PLACEHOLDER

# Telegram/backend request and long-polling timeouts, in seconds.
MORDRED_TELEGRAM_CONNECT_TIMEOUT_SECONDS=3
MORDRED_TELEGRAM_READ_TIMEOUT_SECONDS=100
MORDRED_TELEGRAM_POLL_TIMEOUT_SECONDS=30
